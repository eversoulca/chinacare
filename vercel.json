{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/supabase-keepalive", "schedule": "0 2 * * *" },
    { "path": "/api/supabase-keepalive", "schedule": "0 10 * * *" },
    { "path": "/api/supabase-keepalive", "schedule": "0 18 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
